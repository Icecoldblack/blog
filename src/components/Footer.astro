---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <!-- Social links row -->
    <div class="social-links">
      {[
        { label: "discord",   href: "https://discord.gg/BgKg9gskM2" },
        { label: "instagram", href: "https://www.instagram.com/progsuhq/" },
        { label: "linkedin",  href: "https://www.linkedin.org/company/progsu" },
        { label: "email",     href: "mailto:official@progsu.com" },
      ].map((l) => (
        <a href={l.href} class="social-link">{l.label}</a>
      ))}
    </div>

    <!-- Copyright -->
    <p class="copyright">
      &copy; {year}&nbsp;
      <a href="https://progsu.com">progsu</a>
    </p>
  </div>
</footer>

<style>
  footer {
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 6rem;
    padding: 3rem 2rem;
    text-align: center;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .social-link {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.70);
    text-decoration: none;
    transition: color 0.25s;
  }

  .social-link:hover {
    color: #fff;
  }

  .copyright {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.50);
    margin: 0;
  }

  .copyright a {
    color: rgba(255, 255, 255, 0.50);
    text-decoration: none;
    transition: color 0.25s;
  }

  .copyright a:hover {
    color: #fff;
  }
</style>
