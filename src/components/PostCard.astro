---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, date, description } = post.data;
const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<a href={`/posts/${post.slug}`} class="post-card float-in">
  <time class="card-date" datetime={date.toISOString()}>{formattedDate.toLowerCase()}</time>
  <h2 class="card-title">{title}</h2>
  {description && <p class="card-desc">{description}</p>}
  <span class="card-cta" aria-hidden="true">read</span>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    padding: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: transparent;
    transition: border-color 0.3s ease, background 0.3s ease;
    position: relative;
  }

  .post-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(255, 255, 255, 0);
    transition: background 0.3s ease;
  }

  .post-card:hover {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.02);
  }

  .post-card:hover::before {
    background: rgba(255, 255, 255, 0.5);
  }

  .card-date {
    display: block;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.30);
    margin-bottom: 0.75rem;
    text-transform: lowercase;
  }

  .card-title {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-style: italic;
    font-weight: 700;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.35;
    margin-bottom: 0.6rem;
    letter-spacing: -0.01em;
    flex: 1;
    transition: color 0.2s ease;
  }

  .post-card:hover .card-title {
    color: #fff;
  }

  .card-desc {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .card-cta {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.22);
    transition: color 0.25s ease, letter-spacing 0.25s ease;
    display: inline-block;
    align-self: flex-start;
  }

  .post-card:hover .card-cta {
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.26em;
  }

  @media (max-width: 600px) {
    .post-card {
      padding: 1.5rem;
    }
  }
</style>
