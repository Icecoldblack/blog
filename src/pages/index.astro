---
import { getCollection } from "astro:content";
import HomeLayout from "@/layouts/HomeLayout.astro";
import PostCard from "@/components/PostCard.astro";
import Spring2026RecapGallery from "@/components/Spring2026RecapGallery";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<HomeLayout>

  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-inner float-in">
      <h1 class="hero-title display">progsu / blog</h1>
      <p class="hero-sub">stories, events & ideas from georgia state's programming community</p>
    </div>
  </section>

  <!-- ── Magazine feature (3D circular gallery) ──────────────── -->
  <Spring2026RecapGallery client:only="react" />

  <!-- ── Posts grid ────────────────────────────────────────────── -->
  <section class="page-section float-in">
    <div class="container">
      <header class="section-head">
        <span class="section-label">all posts</span>
        <span class="section-meta">{posts.length} posts</span>
      </header>

      {posts.length === 0 ? (
        <p class="empty-state">no posts yet. check back soon.</p>
      ) : (
        <div class="posts-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      )}
    </div>
  </section>

</HomeLayout>

<style>
  /* ── Shared container ─────────────────────────────────────── */
  .container {
    max-width: 896px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ── Section spacing ──────────────────────────────────────── */
  .page-section {
    padding: 5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* ── Section header ───────────────────────────────────────── */
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .section-label {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.55);
    text-transform: uppercase;
  }

  .section-meta {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.28);
  }

  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    min-height: calc(100dvh - 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 4rem 2rem;
  }

  .hero-inner {
    text-align: center;
    max-width: 44rem;
  }

  .hero-title {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3rem, 8vw, 5.5rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #fff;
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.40);
    line-height: 1.8;
    letter-spacing: 0.02em;
    max-width: 38ch;
    margin: 0 auto;
  }

  /* ── Posts grid ───────────────────────────────────────────── */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .posts-grid :global(.post-card) {
    background: #000;
    border: none;
    border-radius: 0;
  }

  .posts-grid :global(.post-card::before) {
    display: none;
  }

  .posts-grid :global(.post-card:hover) {
    background: rgba(255, 255, 255, 0.025);
    border-color: transparent;
  }

  /* Last card spans both columns when it's the only one in its row */
  .posts-grid :global(.post-card:last-child:nth-child(odd)) {
    grid-column: 1 / -1;
  }

  .empty-state {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.40);
    padding: 4rem 0;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 600px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }

    .hero-title {
      font-size: clamp(2.5rem, 12vw, 3.5rem);
    }

    .page-section {
      padding: 3.5rem 0;
    }
  }
</style>
