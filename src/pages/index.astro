---
import { getCollection } from "astro:content";
import HomeLayout from "@/layouts/HomeLayout.astro";
import PostCard from "@/components/PostCard.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<HomeLayout>

  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-inner float-in">
      <h1 class="hero-title glow-pulse-title">progsu / blog</h1>
      <p class="hero-sub">stories, events & ideas from georgia state's programming community</p>
    </div>
    <div class="hero-scroll-cue float-in" aria-hidden="true">
      <span class="scroll-line"></span>
    </div>
  </section>

  <!-- ── Magazine feature ──────────────────────────────────────── -->
  <section class="page-section float-in">
    <div class="container">
      <header class="section-head">
        <span class="section-label">spring 2026 recap</span>
        <span class="section-meta">magazine</span>
      </header>

      <div id="magazine">
        <div class="mag-carousel-wrap">
          <button class="mag-prev" id="mag-prev" aria-label="Previous page">&#8249;</button>
          <div class="mag-track" id="mag-track" role="region" aria-label="Spring 2026 recap magazine">
            {[1,2,3,4,5,6,7,8].map((n) => (
              <div class="mag-slide">
                <img
                  src={`/images/spring-2026/magazine/page-${n}.jpg`}
                  alt={`spring 2026 recap, page ${n}`}
                  loading={n === 1 ? "eager" : "lazy"}
                  draggable="false"
                  data-page={n}
                />
              </div>
            ))}
          </div>
          <button class="mag-next" id="mag-next" aria-label="Next page">&#8250;</button>
        </div>
        <div class="mag-dots" id="mag-dots" aria-hidden="true">
          {[1,2,3,4].map((n) => (
            <button class={`mag-dot${n === 1 ? " active" : ""}`} data-index={n - 1} aria-label={`Go to page ${n}`} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Posts grid ────────────────────────────────────────────── -->
  <section class="page-section float-in">
    <div class="container">
      <header class="section-head">
        <span class="section-label">all posts</span>
        <span class="section-meta">{posts.length} posts</span>
      </header>

      {posts.length === 0 ? (
        <p class="empty-state">no posts yet. check back soon.</p>
      ) : (
        <div class="posts-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      )}
    </div>
  </section>

  <!-- Lightbox — outside sections, fixed to viewport -->
  <div id="mag-lightbox" aria-hidden="true" aria-modal="true" role="dialog">
    <button id="mag-lb-close" aria-label="Close">&#10005;</button>
    <img id="mag-lb-img" src="" alt="" />
  </div>

</HomeLayout>

<style>
  /* ── Shared container ─────────────────────────────────────── */
  .container {
    max-width: 896px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ── Section spacing ──────────────────────────────────────── */
  .page-section {
    padding: 5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* ── Section header ───────────────────────────────────────── */
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .section-label {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.55);
    text-transform: uppercase;
  }

  .section-meta {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.28);
  }

  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    min-height: calc(100dvh - 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 4rem 2rem;
  }

  .hero-inner {
    text-align: center;
    max-width: 44rem;
  }

  .hero-title {
    font-family: 'Noto Serif', Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3rem, 8vw, 5.5rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #fff;
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.40);
    line-height: 1.8;
    letter-spacing: 0.02em;
    max-width: 38ch;
    margin: 0 auto;
  }

  .hero-scroll-cue {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scroll-line {
    width: 1px;
    height: 3rem;
    background: linear-gradient(to bottom, rgba(255,255,255,0.20), rgba(255,255,255,0));
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.4; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.15); }
  }

  /* ── Magazine carousel ───────────────────────────────────── */
  #magazine {
    margin-bottom: 0;
  }

  .mag-carousel-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mag-prev, .mag-next {
    flex: 0 0 auto;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.45);
    font-size: 2.25rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.5rem 0.4rem;
    transition: color 0.2s;
    user-select: none;
  }

  .mag-prev:hover, .mag-next:hover { color: rgba(255, 255, 255, 0.80); }

  .mag-track {
    flex: 1;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    gap: 0.75rem;
    scrollbar-width: none;
    cursor: grab;
  }

  .mag-track::-webkit-scrollbar { display: none; }
  .mag-track:active { cursor: grabbing; }

  .mag-slide {
    flex: 0 0 auto;
    width: calc(50% - 0.375rem);
    scroll-snap-align: start;
    border-radius: 3px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.02);
  }

  .mag-slide img {
    width: 100%;
    height: auto;
    display: block;
    cursor: zoom-in;
    user-select: none;
  }

  .mag-dots {
    display: flex;
    gap: 0.4rem;
    justify-content: center;
    margin-top: 1.25rem;
  }

  .mag-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }

  .mag-dot.active {
    background: rgba(255, 255, 255, 0.75);
    transform: scale(1.35);
  }

  /* ── Lightbox ─────────────────────────────────────────────── */
  #mag-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    align-items: center;
    justify-content: center;
  }

  #mag-lightbox.open { display: flex; }

  #mag-lb-img {
    max-width: 88vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 0 80px rgba(0, 0, 0, 0.6);
  }

  #mag-lb-close {
    position: fixed;
    top: 1.25rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.45);
    font-size: 1.25rem;
    cursor: pointer;
    padding: 0.5rem;
    transition: color 0.2s;
    z-index: 1000;
  }

  #mag-lb-close:hover { color: #fff; }

  /* ── Posts grid ───────────────────────────────────────────── */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .posts-grid :global(.post-card) {
    background: #000;
    border: none;
    border-radius: 0;
  }

  .posts-grid :global(.post-card::before) {
    display: none;
  }

  .posts-grid :global(.post-card:hover) {
    background: rgba(255, 255, 255, 0.025);
    border-color: transparent;
  }

  /* Last card spans both columns when it's the only one in its row */
  .posts-grid :global(.post-card:last-child:nth-child(odd)) {
    grid-column: 1 / -1;
  }

  .empty-state {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.40);
    padding: 4rem 0;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 600px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }

    .hero-title {
      font-size: clamp(2.5rem, 12vw, 3.5rem);
    }

    /* Show 1 magazine page at a time on mobile */
    .mag-slide {
      width: calc(88vw - 2rem);
    }

    .page-section {
      padding: 3.5rem 0;
    }

    .mag-prev, .mag-next {
      font-size: 1.75rem;
      padding: 0.5rem 0.25rem;
    }
  }
</style>

<script>
  const track    = document.getElementById("mag-track");
  const dots     = document.querySelectorAll(".mag-dot");
  const PAGES    = 4;
  const PER_PAGE = 2;
  let current    = 0;
  let scrolling  = false;
  let autoActive = false;
  let autoTimer: ReturnType<typeof setTimeout> | null = null;
  let idleTimer: ReturnType<typeof setTimeout> | null = null;

  function goTo(page: number) {
    const p = (page + PAGES) % PAGES;
    const slide = track?.children[p * PER_PAGE] as HTMLElement | undefined;
    if (!slide || !track) return;
    scrolling = true;
    track.scrollTo({ left: slide.offsetLeft, behavior: "smooth" });
    dots.forEach((d, i) => d.classList.toggle("active", i === p));
    current = p;
    setTimeout(() => { scrolling = false; }, 700);
  }

  function scheduleNext() {
    if (!autoActive) return;
    autoTimer = setTimeout(() => {
      if (!scrolling) goTo(current + 1);
      scheduleNext();
    }, 6000);
  }

  function startAuto() {
    autoActive = true;
    scheduleNext();
  }

  function stopAuto() {
    autoActive = false;
    if (autoTimer) { clearTimeout(autoTimer); autoTimer = null; }
  }

  function onManual() {
    stopAuto();
    if (idleTimer) clearTimeout(idleTimer);
    idleTimer = setTimeout(startAuto, 10000);
  }

  dots.forEach((dot, i) => dot.addEventListener("click", () => { goTo(i); onManual(); }));

  document.getElementById("mag-prev")?.addEventListener("click", () => { goTo(current - 1); onManual(); });
  document.getElementById("mag-next")?.addEventListener("click", () => { goTo(current + 1); onManual(); });

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "ArrowRight") { goTo(current + 1); onManual(); }
    if (e.key === "ArrowLeft")  { goTo(current - 1); onManual(); }
    if (e.key === "Escape")     closeLightbox();
  });

  const lightbox = document.getElementById("mag-lightbox");
  const lbImg    = document.getElementById("mag-lb-img") as HTMLImageElement | null;

  function openLightbox(src: string, alt: string) {
    if (!lightbox || !lbImg) return;
    lbImg.src = src;
    lbImg.alt = alt;
    lightbox.classList.add("open");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    lightbox?.classList.remove("open");
    lightbox?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  track?.querySelectorAll(".mag-slide img").forEach((img) => {
    img.addEventListener("click", () => {
      const el = img as HTMLImageElement;
      openLightbox(el.src, el.alt);
    });
  });

  document.getElementById("mag-lb-close")?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (e) => { if (e.target === lightbox) closeLightbox(); });

  track?.addEventListener("pointerdown", () => onManual());
  track?.addEventListener("touchstart",  () => onManual(), { passive: true });

  track?.addEventListener("scroll", () => {
    if (scrolling || !track) return;
    const slideW = (track.children[0] as HTMLElement)?.offsetWidth + 12;
    const page   = Math.min(Math.round(track.scrollLeft / slideW / PER_PAGE), PAGES - 1);
    if (page !== current) {
      dots.forEach((d, i) => d.classList.toggle("active", i === page));
      current = page;
      onManual();
    }
  }, { passive: true });

  startAuto();
</script>
